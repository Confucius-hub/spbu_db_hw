# Скопируйте этот файл в .env и при необходимости измените значения.
# (При первом `npm install`/`npm run dev` .env создаётся автоматически.)

# Локальная база данных (SQLite — файл создаётся автоматически)
DATABASE_URL="file:./dev.db"

# Доступ в админ-панель (/admin)
ADMIN_PASSWORD="sro-admin-2026"
# Секрет для подписи сессионной cookie админа (любая длинная случайная строка)
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string-please-0192837465"

# Базовый адрес сайта (для sitemap, robots, canonical, OG)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ——— Необязательные интеграции ———

# Уведомления о заявках в Telegram. Если оба значения заданы — каждая заявка
# с сайта приходит в чат. Как получить:
#   1) создайте бота через @BotFather → получите TOKEN;
#   2) узнайте chat_id (например, через @userinfobot или getUpdates).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Встраиваемая карта на странице «Контакты». Вставьте src из конструктора
# Яндекс.Карт ("Поделиться" → "Код карты", URL вида https://yandex.ru/map-widget/...)
# или OpenStreetMap (export → HTML, ссылка вида https://www.openstreetmap.org/export/embed.html?...).
# Если пусто — показывается фирменная заглушка с адресом.
NEXT_PUBLIC_MAP_EMBED_URL=""

# Живая лента отрасли на странице /news (Google Новости RSS).
# Работает автоматически; здесь можно изменить поисковый запрос.
# Если источник недоступен — блок просто скрывается.
NEXT_PUBLIC_NEWS_QUERY="СРО строительство НОСТРОЙ саморегулирование"
